{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lich-truc-na-ri-api",
  "main": "worker-build/index.mjs",
  "no_bundle": true,
  "build": {"command":"npm run build:worker"},
  "tsconfig": "worker/tsconfig.json",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "833b932552c94f8629e0f39dde910fbb",
  "workers_dev": true,
  "vars": { "MONITOR_ACCOUNT_ID":"833b932552c94f8629e0f39dde910fbb", "MONITOR_DATABASE_ID":"d302dddb-2339-4b3f-87e8-672a1c4e655d", "APP_ORIGIN": "https://lich-truc-na-ri.pages.dev", "ALLOWED_ORIGINS": "https://quan-ly-lich-truc-d9nyp4d92-noitru.vercel.app,https://quan-ly-lich-truc.vercel.app,https://lich-truc-na-ri.pages.dev", "ALLOW_LOCAL_HTTP": "false", "ADMIN_GOOGLE_EMAIL": "dtc245160052@ictu.edu.vn,nghiapipi123@gmail.com", "GOOGLE_CLIENT_ID": "43585717168-k9l6h7i4bdffvurq9ag1hqicelsb7l1g.apps.googleusercontent.com" },
  "d1_databases": [{ "binding": "DB", "database_name": "lich-truc-na-ri", "database_id": "d302dddb-2339-4b3f-87e8-672a1c4e655d", "migrations_dir": "migrations" }],
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "ScheduleRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ScheduleRoom"] }],
